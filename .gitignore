
# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
*.gate.lock*

# Per-machine Dolt server state (runtime)
.beads/.dolt-server-state.json

# Node and build output
node_modules/
dist/
coverage/
*.tsbuildinfo

# What `claude --plugin-dir plugins/<name>` writes into the plugin when a session loads it: the
# mod types under .claude-plugin/types/ (which also carries its own `*` .gitignore) and a
# tsconfig.json at the plugin root that extends them.
**/.claude-plugin/types/
plugins/*/tsconfig.json

# Local environment (never commit secrets)
.env
.env.local
.direnv/
