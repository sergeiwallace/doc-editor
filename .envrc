# shellcheck shell=bash
# Project environment (loaded by direnv)
PROJECT_NAME="doc-editor"

# Suppress variable-name listing; show vague confirmation instead
export DIRENV_LOG_FORMAT=""
>&2 echo "direnv: ${PROJECT_NAME} environment loaded"

# Load secrets from Doppler (project: sergei, config: dev) — canonical store on all hosts.
# To add a secret: doppler secrets set KEY_NAME --project sergei --config dev
#
# load_ai_core_secrets is a direnv stdlib *extension function*, not a program on
# PATH — only a direnvrc defines it, and machines without that direnvrc used to
# get `load_ai_core_secrets: command not found`. direnv does not abort
# the file on that error, so every secret was silently left unset with one opaque
# line as the signal. Guard the call and name the consequence instead.
#
# There is deliberately no way to silence the warning: this file cannot know
# whether THIS machine is supposed to have the loader, and an opt-out would go
# quiet on exactly the machine where a missing loader is a real regression.
if declare -F load_ai_core_secrets >/dev/null; then
  load_ai_core_secrets
else
  >&2 echo "direnv: WARNING load_ai_core_secrets is not defined -- no direnvrc provides it, so Doppler-backed secrets are NOT loaded and commands needing them will fail"
fi
export LANGCHAIN_TRACING_V2=false
